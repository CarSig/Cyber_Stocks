{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "watchAssets": false,
  "compilerOptions": {
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true
        }
      }
    ],
    "assets": [],
    "watchOptions": {
      "ignored": ["dist/**", "node_modules/**", "**/*.tsbuildinfo"]
    },
    "tsConfigPath": "tsconfig.json"
  }
}
