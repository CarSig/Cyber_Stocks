{
  "name": "cyber-stock-intelligence-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:shared": "npm run build --prefix ../shared",
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "worker": "node dist/workers/newsWorker.js",
    "worker:dev": "tsx src/workers/newsWorker.ts | npx pino-pretty",
    "ingest:archive": "tsx src/workers/archiveIngester.ts | npx pino-pretty",
    "ingest:reanalyze": "tsx src/workers/archiveIngester.ts --reanalyze | npx pino-pretty",
    "ingest:parse-dry-run": "tsx src/workers/archiveDryRun.ts | npx pino-pretty",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit"
  },
  "dependencies": {
    "@algo/shared": "file:../shared",
    "@anthropic-ai/sdk": "^0.90.0",
    "@arizeai/openinference-instrumentation-anthropic": "^0.1.10",
    "@clerk/backend": "^3.4.1",
    "@mozilla/readability": "^0.6.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^5.0.0",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/auto-instrumentations-node": "^0.75.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@sentry/node": "^10.49.0",
    "@stdlib/stats-pcorrtest": "^0.2.3",
    "@xmldom/xmldom": "^0.9.10",
    "amqplib": "^1.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsdom": "^29.0.2",
    "jsonwebtoken": "^9.0.3",
    "natural": "^8.1.1",
    "nestjs-pino": "^4.3.0",
    "openai": "^6.0.0",
    "pg": "^8.11.0",
    "pino": "^10.3.1",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sentiment": "^5.0.2",
    "swagger-ui-express": "^5.0.1",
    "vader-sentiment": "^1.1.3",
    "yahoo-finance2": "^3.13.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/natural": "^5.1.5",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ]
  }
}
